{
  "name": "cultura",
  "version": "0.1.0",
  "private": true,
  "description": "Cultura — agenda cultural de Angola. Une base de code, deux cibles de build (web et mobile).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build:web": "cross-env BUILD_TARGET=web next build",
    "build:mobile": "cross-env BUILD_TARGET=mobile next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/rls/** --exclude tests/storage/**",
    "test:rls": "vitest run tests/rls tests/storage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "hooks:install": "node scripts/install-hooks.cjs",
    "prepare": "node scripts/install-hooks.cjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.cjs\" \"*.{json,mjs,mts,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.cjs\" \"*.{json,mjs,mts,ts}\"",
    "measure": "node scripts/measure-render.cjs",
    "secrets": "gitleaks detect --no-banner --redact",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "pg": "^8.23.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
