# Fichiers binaires : jamais de diff textuel ni de textconv (évite les erreurs
# docx2txt pendant les scans gitleaks et accélère Git).
*.docx binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.apk binary
*.aab binary

# Hook versionné : doit garder des fins de ligne LF, sinon Git Bash refuse
# d'exécuter le script (CRLF).
.githooks/* text eol=lf
*.sh text eol=lf
