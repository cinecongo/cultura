# =============================================================================
# CULTURA — modèle de variables d'environnement
# -----------------------------------------------------------------------------
# Ce fichier ne contient AUCUNE valeur réelle. Il documente les noms attendus.
# Copier en `.env.local` (web local) ou renseigner les secrets CI / Vercel.
# `.env*` est ignoré par Git, sauf ce fichier.
#
# Règle absolue : tout ce qui est préfixé NEXT_PUBLIC_ est PUBLIC et embarqué
# dans le JavaScript et dans l'APK. Aucun secret ne doit porter ce préfixe.
# =============================================================================

# --- Application -------------------------------------------------------------
# URL canonique de production, sans slash final. Ex. https://cultura.ao
NEXT_PUBLIC_SITE_URL=

# Cible de build : `web` (SSR/ISR, Vercel) ou `mobile` (export statique Capacitor).
NEXT_PUBLIC_APP_TARGET=web

# Langue par défaut si aucune préférence : pt | fr | en
NEXT_PUBLIC_DEFAULT_LOCALE=pt

# --- Supabase ----------------------------------------------------------------
# Projet Supabase. Clés disponibles dans Settings > API Keys.
# Depuis 2025, Supabase fournit deux formats :
#   - clé « publishable » (`sb_publishable_…`) → variable ci-dessous ;
#   - clé « secrète » (`sb_secret_…`) → SUPABASE_SERVICE_ROLE_KEY.
# Les anciennes clés JWT (anon / service_role, `eyJ…`) restent acceptées.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PUBLIC PAR CONCEPTION, mais sûr uniquement parce que la RLS est active partout.
# Ne jamais utiliser cette clé pour contourner une politique RLS.

# Serveur uniquement : Edge Functions, routes serveur, scripts d'administration.
# Ne jamais préfixer NEXT_PUBLIC_. Ne jamais exposer au navigateur ni à l'APK.
SUPABASE_SERVICE_ROLE_KEY=

# Identifiant du projet (CLI Supabase).
SUPABASE_PROJECT_ID=

# Jeton d'accès personnel Supabase pour la CI et la CLI (link, db push). Secret.
SUPABASE_ACCESS_TOKEN=

# Mot de passe de la base (migrations distantes, dump, restauration). Secret.
# Connexion : pooler uniquement (la connexion directe est IPv6 et cette machine
# n'a pas d'IPv6) — aws-1-eu-west-1.pooler.supabase.com:5432, utilisateur
# postgres.<project-ref>. Voir ADR-006.
SUPABASE_DB_PASSWORD=

# --- Emails transactionnels --------------------------------------------------
# Envoi par le script PHP `scripts/mailer.php` (décision du 2026-11-27).
# Deux modes, jamais de secret dans le dépôt :
#  - développement / e2e : MAIL_OUTBOX_FILE, bac à sable fichier hors Git où le
#    script écrit les messages ; les tests y lisent les liens de vérification.
#  - production : SMTP (hôte, port, utilisateur, mot de passe) + EMAIL_FROM
#    vérifié. Le script n'affiche jamais ces valeurs.
PHP_BINARY=
MAIL_OUTBOX_FILE=
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
EMAIL_FROM=
# Réservé : fournisseur alternatif si le SMTP est remplacé (O6).
RESEND_API_KEY=

# --- Anti-abus ---------------------------------------------------------------
# Cloudflare Turnstile : la clé de site est publique, la clé secrète ne l'est pas.
# Clés de test (O7) : le widget est désactivé en production, où de vraies clés
# liées au domaine final sont exigées (échec fermé).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Clé HMAC servant à opacifier les identifiants dans la table de limitation de
# débit. Secret serveur ; à défaut, la clé service_role est utilisée.
AUTH_RATE_LIMIT_SECRET=

# --- Observabilité -----------------------------------------------------------
# Erreurs uniquement, sans données personnelles.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Android (P9) ------------------------------------------------------------
# Nom de package définitif — non modifiable après publication sur le Play Store.
ANDROID_PACKAGE_NAME=

# --- Rappels ----------------------------------------------------------------
# Le seuil de lancement (50 acteurs actifs) n'est PAS une variable
# d'environnement : il vit en base, dans la table de configuration (A17).
# Les secrets de signature Android (keystore, mots de passe) ne sont jamais
# dans `.env` du dépôt : stockés hors ligne + secrets CI.
